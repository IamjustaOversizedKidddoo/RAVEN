{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAVEN Tool Schema",
  "description": "Schema definition for tools cataloged in the RAVEN OSINT Arsenal",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "description",
      "category",
      "repository",
      "language",
      "interface",
      "platform",
      "installation",
      "requires_api_key",
      "requires_authentication",
      "paid_dependencies",
      "license",
      "status",
      "tags",
      "added_date",
      "last_verified"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "secondary_categories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "repository": {
        "type": "string"
      },
      "website": {
        "type": "string"
      },
      "language": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "interface": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "CLI",
            "Web",
            "GUI",
            "API",
            "Browser Extension",
            "Library"
          ]
        }
      },
      "platform": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "installation": {
        "type": "string"
      },
      "requires_api_key": {
        "type": "boolean"
      },
      "requires_authentication": {
        "type": "boolean"
      },
      "paid_dependencies": {
        "type": "boolean"
      },
      "license": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "Active",
          "Archived",
          "Experimental",
          "Unknown"
        ]
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "added_date": {
        "type": "string"
      },
      "last_verified": {
        "type": "string"
      },
      "how_to_use": {
        "type": "string",
        "description": "Practical instructions and operational guidance explaining how the tool can be used."
      },
      "command_example": {
        "type": "string",
        "description": "Quick-start example command syntax for the tool."
      },
      "about": {
        "type": "string",
        "description": "Brief explanation describing the tool, its core mechanics, and why it is useful."
      },
      "who_can_use": {
        "type": "string",
        "description": "Target audience and professional roles who can benefit from using this tool."
      }
    }
  }
}